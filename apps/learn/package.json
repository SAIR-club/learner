{
  "name": "@episteme/app-learn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive Learn surface: ask, inspect retrieval signals, record understanding.",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./topic-file": {
      "types": "./dist/topic-file.d.ts",
      "default": "./dist/topic-file.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "bin": {
    "episteme-learn": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "learn": "tsc -b && node dist/cli.js",
    "serve": "tsc -b && node dist/serve.js"
  },
  "dependencies": {
    "@episteme/agent": "*",
    "@episteme/core": "*",
    "@episteme/domain-learn": "workspace:*",
    "@episteme/sdk": "*",
    "@episteme/storage-local": "*",
    "dotenv": "^16.4.7"
  }
}
